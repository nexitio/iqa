[TEMPLATE]
# Copy to .env and fill in. Never commit the real file.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ilm
DATABASE_ADMIN_URL=postgresql://USER:PASSWORD@localhost:5432/postgres
ILM_API_PORT=8787

# Password every seeded account signs in with. Development only.
ILM_SEED_PASSWORD=ilm-dev-password

# Session cookie. Defaults: SameSite=Lax, Secure only in production.
# A frontend on a different *site* (not just a different port) needs
# ILM_COOKIE_SAMESITE=none together with ILM_COOKIE_SECURE=true.
ILM_COOKIE_SAMESITE=lax
ILM_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Second-factor delivery
#
# `console` writes the code to the server log AND returns it in the API response,
# because nothing was actually sent. It is refused outright when NODE_ENV is
# production, so it cannot be shipped by accident.
# ---------------------------------------------------------------------------
ILM_EMAIL_PROVIDER=console
ILM_SMS_PROVIDER=console

# ILM_EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# ILM_MAIL_FROM="Ilm <no-reply@your-domain.example>"

# ILM_SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ---------------------------------------------------------------------------
# Passkeys (WebAuthn)
#
# ILM_RP_ID is the domain the passkey is bound to, permanently — changing it
# invalidates every enrolled passkey. ILM_RP_ORIGINS must list every origin the
# browser will run on; a mismatch makes every ceremony fail.
# ---------------------------------------------------------------------------
ILM_RP_ID=localhost
ILM_RP_NAME=Ilm
ILM_RP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8787,http://127.0.0.1:8787

# ---------------------------------------------------------------------------
# Social sign-in
#
# ILM_SECRET_KEY encrypts the client secrets of the providers configured in the
# admin console. Required in production; a development default is used otherwise.
# Changing it makes every stored provider secret unreadable — they have to be
# re-entered.
# ---------------------------------------------------------------------------
ILM_SECRET_KEY=change-me-to-a-long-random-string

# Where a finished social sign-in sends the browser. Never derived from a
# request header.
ILM_WEB_ORIGIN=http://localhost:3000
