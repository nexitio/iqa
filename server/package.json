{
  "name": "@ilm/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ilm API — Hono + Drizzle on PostgreSQL. Serves the domain model in src/lib/types.ts.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:create": "tsx scripts/create-database.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:counts": "tsx scripts/row-counts.ts",
    "db:setup": "tsx scripts/create-database.ts && tsx scripts/migrate.ts && tsx scripts/seed.ts",
    "audit:links": "tsx scripts/audit-links.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@simplewebauthn/server": "^14.0.3",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@levischuck/tiny-cbor": "^0.3.6",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
